								"{{base_url}}"
							],
							"path": [
								"api",
								"method",
								"mob_clinic.mob_clinic.api.auth.mobile_register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store login response data",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.message === 'Logged In') {",
									"        pm.environment.set('practitioner_email', response.user.email);",
									"        console.log('Login successful for:', response.user.email);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usr\": \"doctor@clinic.com\",\n  \"pwd\": \"SecurePass123!\"\n}"
						},
