							"mode": "raw",
							"raw": "{\n  \"full_name\": \"Dr. John Smith\",\n  \"email\": \"doctor@clinic.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"SecurePass123!\",\n  \"clinic_name\": \"City Medical Clinic\"\n}"
						},
