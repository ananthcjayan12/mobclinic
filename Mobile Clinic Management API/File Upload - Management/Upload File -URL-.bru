meta {
  name: Upload File -URL-
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/method/mob_clinic.mob_clinic.api.file_upload.upload_file
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "file_name": "profile_picture.jpg",
    "file_url": "https://example.com/profile.jpg",
    "file_category": "profile",
    "description": "Patient profile picture",
    "reference_doctype": "Patient",
    "reference_name": "{{patient_id}}",
    "is_private": 0
  }
}
