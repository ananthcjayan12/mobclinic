meta {
  name: Get Patient History
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/method/mob_clinic.mob_clinic.api.prescription.get_patient_history?patient_id={{patient_id}}&limit=10
  body: none
  auth: none
}

query {
  patient_id: {{patient_id}}
  limit: 10
  ~from_date: 2025-01-01
  ~to_date: 2025-12-31
}
